{
  "name": "parent-activity-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node scripts/run-tests.js",
    "test:auth": "node --test src/googleAuth.test.js",
    "test:database": "npx supabase db query --linked --file scripts/test-import-review-flow.sql && npx supabase db query --linked --file scripts/test-social-flow.sql && npx supabase db query --linked --file scripts/test-app-workflows.sql",
    "preview": "vite preview",
    "lint": "eslint .",
    "activities:best-start": "node scripts/import-waltham-forest-best-start.js",
    "activities:family-hubs-london": "node scripts/import-london-family-hubs.js",
    "activities:google-family": "node scripts/import-google-places-family.js",
    "activities:images": "node scripts/enrich-activity-images.js --audit",
    "activities:images:missing": "node scripts/enrich-activity-images.js --missing-only",
    "activities:images:audit-scraped": "node scripts/audit-scraped-images.js",
    "activities:images:audit-cafes": "node scripts/audit-cafe-serpapi-images.js",
    "activities:images:download": "node scripts/download-activity-website-images.js",
    "activities:images:wikimedia": "node scripts/populate-wikimedia-images.js",
    "activities:images:wikimedia:parks": "node scripts/populate-wikimedia-images.js --parks-only",
    "activities:images:wikimedia:repair": "node scripts/repair-wikimedia-image-urls.js",
    "activities:images:wikimedia:osm": "node scripts/enrich-wikimedia-from-osm.js",
    "activities:family-cafes": "node scripts/build-high-rated-family-cafes.js",
    "activities:eventbrite-baby": "node scripts/import-eventbrite-baby-london.js",
    "activities:fever-family": "node scripts/import-fever-london-family.js",
    "activities:museums-london": "node scripts/import-museums-london.js",
    "activities:timeout-kids": "node scripts/import-timeout-london-kids.js",
    "activities:loopla-london": "node scripts/import-loopla-london.js",
    "activities:fever-availability": "node scripts/enrich-fever-availability.js",
    "activities:london-parks": "node scripts/build-london-parks.js",
    "activities:audit-happity-links": "node scripts/audit-happity-website-links.js",
    "activities:happity": "node scripts/import-happity-schedules.js",
    "activities:audit-categories": "node scripts/audit-activity-categories.js",
    "activities:audit-suitability": "node scripts/audit-activity-suitability.js",
    "activities:audit-duplicates": "node scripts/audit-cross-source-duplicates.js",
    "activities:audit-websites": "node scripts/audit-activity-websites.js",
    "activities:audit-websites:places": "node scripts/audit-activity-websites.js --google-places",
    "tiny-outings-update": "node scripts/tiny-outings-update.js",
    "tiny-outings-update:apply": "node scripts/tiny-outings-update.js --apply",
    "render:download": "node scripts/prepare-render-download.js",
    "cap:sync": "npm run build && npx cap sync",
    "android:add": "npx cap add android",
    "android:sync": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-android.ps1",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug && cd .. && node scripts/package-release-apk.js",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@supabase/supabase-js": "^2.53.0",
    "@vitejs/plugin-react": "^4.3.4",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "vite": "^6.0.11"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0"
  }
}
